# Copy to infra/.env to override compose defaults. Everything has a working
# default — an empty/absent .env is fine for dev.

# --- Host ports (REQUIRED on the shared deploy box — 6 teams, no squatting) -
# YADRO_HTTP_PORT=18080
# YADRO_API_PORT=18000

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=yadro
POSTGRES_PASSWORD=yadro
POSTGRES_DB=yadro

# --- App knobs (read by core.settings from the environment) -----------------
# CHUNK_WINDOW_S=45
# CHUNK_OVERLAP_S=5
# TARGET_SR=16000
# MAX_CHUNK_RETRIES=3

# --- ML models --------------------------------------------------------------
# Weights live in the hf_cache volume, filled once by the warmup one-shot:
#   docker compose -f infra/docker-compose.yml run --rm ml-warmup
# (scripts/deploy.sh does this automatically on the server). HF_TOKEN is only
# needed while the cache is cold — pyannote is gated on Hugging Face; accept
# the terms for pyannote/segmentation-3.0 + pyannote/speaker-diarization-3.1
# once, then workers run fully offline (offline pins: docker-compose.gpu.yml).
# HF_TOKEN=
# ASR_LANGUAGE=ru      # recommended on the server: lectures are Russian;
#                      # empty = per-chunk autodetect
# --- ML / GPU ---------------------------------------------------------------
# REQUIREMENT: 1080-friendly. Baseline GPU = GTX 1080 (Pascal, CC 6.1):
# CTranslate2 float16 needs CC >= 7.0 -> it will NOT run in float16 there;
# int8 IS supported on CC 6.1 (verified: opennmt.net/CTranslate2/quantization.html).
# The current bootcamp box (RTX A4000, CC 8.6, 16 GB shared by 6 teams) also
# runs float16 — override here per-deployment if the VRAM budget allows.
# ASR_MODEL=large-v3   # local e2e tip: ASR_MODEL=tiny is a ~40x lighter download
# ASR_COMPUTE_TYPE=int8
